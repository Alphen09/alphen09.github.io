*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#0b1020;
color:white;
}

.hero{
text-align:center;
padding:60px 20px;
background:linear-gradient(180deg,#2d005f,#0b1020);
}

.hero-logo{
width:320px;
max-width:90%;
border-radius:20px;
margin-bottom:25px;
}

.hero h1{
font-size:42px;
color:#FFD700;
margin-bottom:15px;
}

.tagline{
font-size:22px;
color:#ffffff;
margin-bottom:10px;
}

.subtitle{
font-size:18px;
color:#d8d8d8;
margin-bottom:25px;
}

#loginBtn{
background:#FFD700;
color:#111;
padding:15px 35px;
border:none;
border-radius:12px;
font-size:18px;
font-weight:bold;
cursor:pointer;
transition:.3s;
}

#loginBtn:hover{
background:#7B2EFF;
color:white;
}

.navbar{
display:flex;
justify-content:center;
gap:25px;
padding:18px;
background:#141c33;
}

.navbar a{
color:white;
text-decoration:none;
font-weight:bold;
}

.navbar a:hover{
color:#FFD700;
}

.featured,
.museum{
padding:60px 8%;
text-align:center;
}

.grid{
display:flex;
justify-content:center;
gap:25px;
flex-wrap:wrap;
margin-top:30px;
}

.card{
width:280px;
background:#18233d;
border-radius:15px;
padding:20px;
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
box-shadow:0 0 20px #7B2EFF;
}

.card img{
width:100%;
border-radius:12px;
margin-bottom:15px;
}

.card h3{
color:#FFD700;
margin-bottom:10px;
}

.card p{
color:#d8d8d8;
margin-bottom:15px;
}

.card button,
.museum button{
background:#FFD700;
color:#111;
padding:12px 25px;
border:none;
border-radius:10px;
cursor:pointer;
font-weight:bold;
transition:.3s;
}

.card button:hover,
.museum button:hover{
background:#7B2EFF;
color:white;
}

footer{
background:#141c33;
padding:30px;
text-align:center;
color:#cccccc;
margin-top:60px;
}