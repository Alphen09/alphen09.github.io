*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#120022;
    color:#fff;
    overflow-x:hidden;
}

/* HEADER */

.header{
    background:linear-gradient(135deg,#3b0066,#6a00b8);
    padding:25px 15px;
    text-align:center;
    border-bottom:2px solid #FFD700;
    box-shadow:0 0 20px rgba(255,215,0,.25);
}

.header h1{
    color:#FFD700;
    font-size:32px;
    margin-bottom:20px;
}

.search{
    width:100%;
    max-width:450px;
    padding:14px;
    border:none;
    border-radius:12px;
    font-size:16px;
    outline:none;
}

/* GRID */

.market-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
    padding:25px;
    max-width:1400px;
    margin:auto;
}

/* CARD */

.card{
    background:#24003d;
    border-radius:18px;
    overflow:hidden;
    text-align:center;
    box-shadow:0 0 18px rgba(255,215,0,.25);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 0 28px gold;
}

.card img{
    display:block;
    width:160px;
    height:160px;
    margin:20px auto;
    object-fit:contain;
    object-position:center;
    background:transparent;
    padding:0;
}

.card h2{
    color:#FFD700;
    font-size:22px;
    padding:15px 10px 5px;
}

.card p{
    color:#ddd;
    font-size:18px;
    margin-bottom:15px;
}

.buy-btn{
    background:#FFD700;
    color:#000;
    border:none;
    padding:14px 30px;
    border-radius:10px;
    cursor:pointer;
    font-size:16px;
    font-weight:bold;
    margin-bottom:20px;
    transition:.3s;
}

.buy-btn:hover{
    background:#fff;
    transform:scale(1.05);
}

/* MOBILE */

@media(max-width:768px){

.header h1{
    font-size:24px;
}

.market-grid{
    grid-template-columns:1fr;
    padding:15px;
}

.card{
    max-width:380px;
    margin:auto;
}

.card img{
    height:220px;
}

.search{
    font-size:15px;
}

}