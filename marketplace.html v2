<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alberto NFT Marketplace</title>

    <link rel="stylesheet" href="marketplace.css">

    <script src="https://sdk.minepi.com/pi-sdk.js"></script>
</head>

<body>

<header class="header">

    <div class="brand">
        <img
            src="images/logo.png"
            class="logo"
            alt="Alberto NFT Marketplace Logo"
        >

        <div>
            <h1>Alberto NFT Marketplace</h1>
            <p>Discover • Collect • Trade with Pi</p>
        </div>
    </div>

    <div id="pi-user" class="pi-user">
        👤 Pi Pioneer
    </div>

    <input
        id="searchNFT"
        class="search"
        type="search"
        placeholder="🔎 Search NFTs..."
        autocomplete="off"
    >

</header>


<nav class="categories">

    <button class="category-btn active" type="button" data-category="all">
        All NFTs
    </button>

    <button class="category-btn" type="button" data-category="games">
        🎮 Games
    </button>

    <button class="category-btn" type="button" data-category="art">
        🎨 Art
    </button>

    <button class="category-btn" type="button" data-category="collectibles">
        💎 Collectibles
    </button>

    <button class="category-btn" type="button" data-category="pets">
        🐾 Pets
    </button>

    <button class="category-btn" type="button" data-category="characters">
        ⚔️ Characters
    </button>

    <button class="category-btn" type="button" data-category="mounts">
        🚀 Mounts
    </button>

    <button class="category-btn" type="button" data-category="rare">
        👑 Rare
    </button>

</nav>


<main>

    <section class="market-intro">

        <h2>Explore NFTs</h2>

        <p>
            Discover digital art, collectibles,
            game assets, characters, pets and rare creations.
        </p>

    </section>


    <section
        id="nftGrid"
        class="market-grid"
        aria-label="NFT Marketplace"
    >


        <!-- NFT 1 -->

        <article
            class="card"
            data-category="collectibles"
            data-nft-id="SATOSHI-WINGS-001"
        >

            <img
                src="satoshi-devil-wing.png"
                alt="Satoshi Devil Wings +30"
                loading="lazy"
            >

            <div class="card-content">

                <span class="badge">
                    Collectible
                </span>

                <h2>Satoshi Devil Wings +30</h2>

                <p class="collection">
                    Satoshi Wings
                </p>

                <p class="price">
                    <strong>500</strong> Pi
                </p>

                <button
                    class="buy-btn"
                    type="button"
                    data-price="500"
                    data-nft="Satoshi Devil Wings +30"
                    data-nft-id="SATOSHI-WINGS-001"
                >
                    Buy with Pi
                </button>

            </div>

        </article>


        <!-- NFT 2 -->

        <article
            class="card"
            data-category="collectibles"
            data-nft-id="SATOSHI-WINGS-002"
        >

            <img
                src="satoshi-archangel-wing.png"
                alt="Satoshi Archangel Wings +30"
                loading="lazy"
            >

            <div class="card-content">

                <span class="badge">
                    Collectible
                </span>

                <h2>Satoshi Archangel Wings +30</h2>

                <p class="collection">
                    Satoshi Wings
                </p>

                <p class="price">
                    <strong>800</strong> Pi
                </p>

                <button
                    class="buy-btn"
                    type="button"
                    data-price="800"
                    data-nft="Satoshi Archangel Wings +30"
                    data-nft-id="SATOSHI-WINGS-002"
                >
                    Buy with Pi
                </button>

            </div>

        </article>


        <!-- NFT 3 -->

        <article
            class="card"
            data-category="collectibles"
            data-nft-id="SATOSHI-WINGS-003"
        >

            <img
                src="satoshi-dark-angel-wing.png"
                alt="Satoshi Dark Angel Wings +30"
                loading="lazy"
            >

            <div class="card-content">

                <span class="badge">
                    Rare
                </span>

                <h2>Satoshi Dark Angel Wings +30</h2>

                <p class="collection">
                    Satoshi Wings
                </p>

                <p class="price">
                    <strong>1200</strong> Pi
                </p>

                <button
                    class="buy-btn"
                    type="button"
                    data-price="1200"
                    data-nft="Satoshi Dark Angel Wings +30"
                    data-nft-id="SATOSHI-WINGS-003"
                >
                    Buy with Pi
                </button>

            </div>

        </article>


        <!-- NFT 4 -->

        <article
            class="card"
            data-category="mounts"
            data-nft-id="RW3-MOUNT-001"
        >

            <img
                src="satoshi-astral-bike-rw3.png"
                alt="Satoshi Astral Bike RW3"
                loading="lazy"
            >

            <div class="card-content">

                <span class="badge">
                    Mount
                </span>

                <h2>Satoshi Astral Bike RW3</h2>

                <p class="collection">
                    RW3 Mounts
                </p>

                <p class="price">
                    <strong>2000</strong> Pi
                </p>

                <button
                    class="buy-btn"
                    type="button"
                    data-price="2000"
                    data-nft="Satoshi Astral Bike RW3"
                    data-nft-id="RW3-MOUNT-001"
                >
                    Buy with Pi
                </button>

            </div>

        </article>


    </section>


    <section
        id="emptyState"
        class="empty-state"
        hidden
    >

        <h2>No NFTs found</h2>

        <p>
            Try another search or choose a different category.
        </p>

    </section>

</main>


<footer class="market-footer">

    <p>
        © 2026 Alberto NFT Marketplace
    </p>

    <p>
        Built for the Pi ecosystem
    </p>

</footer>


<script src="marketplace.js"></script>

</body>

</html>