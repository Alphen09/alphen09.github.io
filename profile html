<title>Profile | Alberto NFT Marketplace</title>

<link rel="stylesheet" href="index.css">

</head>

<body>

<header class="hero">

<img src="images/alberto-banner.png"
class="hero-logo"
alt="Profile">

<h1>👤 My Profile</h1>

<p class="tagline">
Manage Your Pi Account & NFT Collection
</p>

<button id="loginBtn">
Login with Pi
</button>

</header>

<nav class="navbar">

<a href="index.html">🏠 Home</a>

<a href="museum.html">🏛 Museum</a>

<a href="marketplace.html">🛒 Marketplace</a>

<a href="profile.html">👤 Profile</a>

</nav>

<section class="featured">

<h2>👤 Account Information</h2>

<div class="grid">

<div class="card">
<h3>Pi Username</h3>
<p>Not Connected</p>
</div>

<div class="card">
<h3>Wallet Status</h3>
<p>Not Connected</p>
</div>

<div class="card">
<h3>Total NFTs</h3>
<p>0 NFT</p>
</div>

<div class="card">
<h3>Creator</h3>
<p>Alberto Digital Art Work Studio</p>
</div>

</div>

</section>

<section class="featured">

<h2>🎨 My NFT Collection</h2>

<div class="grid">

<div class="card">
<h3>Owned NFTs</h3>
<p>0 Items</p>
<button>View</button>
</div>

<div class="card">
<h3>Favorites</h3>
<p>0 Items</p>
<button>View</button>
</div>

<div class="card">
<h3>Listed for Sale</h3>
<p>0 Items</p>
<button>Manage</button>
</div>

<div class="card">
<h3>Purchase History</h3>
<p>Coming Soon</p>
<button>View</button>
</div>

</div>

</section>

<section class="featured">

<h2>⚙️ Account Settings</h2>

<div class="grid">

<div class="card">
<h3>Security</h3>
<p>Manage Login & Wallet</p>
</div>

<div class="card">
<h3>Notifications</h3>
<p>Marketplace Updates</p>
</div>

<div class="card">
<h3>Support</h3>
<p>Contact Alberto Studio</p>
</div>

<div class="card">
<h3>About</h3>
<p>Powered by Pi Network</p>
</div>

</div>

</section>
<!-- MINT NFT -->
<section class="mint-section">

    <div class="mint-card">

        <div class="mint-icon">
            🎨
        </div>

        <h2>Mint Your Own NFT</h2>

        <p>
            Create and publish your own Alberto digital asset.
        </p>

        <button
            class="mint-btn"
            onclick="goMint()"
        >
            🎨 Mint New NFT
        </button>

    </div>

</section>

<style>

.mint-section {
    width: 100%;
    max-width: 600px;
    margin: 0 auto 35px;
    padding: 0 20px;
}

.mint-card {
    padding: 28px 20px;
    text-align: center;

    background:
        linear-gradient(
            145deg,
            rgba(35,20,52,.98),
            rgba(12,8,18,.98)
        );

    border:
        1px solid
        rgba(170,100,255,.3);

    border-radius: 22px;

    box-shadow:
        0 12px 35px rgba(0,0,0,.35);
}

.mint-icon {
    font-size: 42px;
    margin-bottom: 10px;
}

.mint-card h2 {
    font-size: 23px;
    margin-bottom: 8px;
}

.mint-card p {
    color: #aaa0b5;
    font-size: 14px;
    margin-bottom: 20px;
}

.mint-btn {
    width: 100%;
    padding: 14px;

    border: none;
    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #7138c8,
            #a653f0
        );

    color: white;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 8px 22px
        rgba(130,60,230,.3);
}

.mint-btn:active {
    transform: scale(.98);
}

</style>
<footer>

<p>
© 2026 Alberto Digital Art Work Studio
</p>

<p>
Powered by Pi Network
</p>

</footer>

